# Copy this file to .env and fill in your key. .env is never committed.

# Free key from https://aistudio.google.com (use your personal Google account)
GEMINI_API_KEY=

# Run `uv run audiobook models` to see which models your key can use.
GEMINI_MODEL=gemini-3.8-flash
# Optional: tried in order when the main model is overloaded or out of free requests (comma-separated)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Pages per Gemini request (fewer requests vs. less risk of hitting output limits)
AUDIOBOOK_PAGES_PER_CHUNK=10

# Default voice for new readings (see the voice list in the app)
AUDIOBOOK_VOICE=af_heart
