# Copy this file to .env and fill in your key. .env is never committed.

# Free key from https://aistudio.google.com (use your personal Google account)
GEMINI_API_KEY=

# Run `uv run audiobook models` to see which models your key can use.
GEMINI_MODEL=gemini-3.5-flash
# Optional: full models to try in order when the main one is busy or out of free
# requests (comma-separated). Each has its own free allowance (20 requests a day
# each, as of Nov 2026), so more backups means more readings a day. Flash-Lite
# models are ignored here: they leave pages out of scripts.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# The Ask tab (questions about a reading) uses these models, tried in order. Its first
# one shares its free allowance with script writing; the daily cap below protects it.
GEMINI_CHAT_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
# Most questions the Ask tab will send per day (it counts down in the tab)
AUDIOBOOK_CHAT_DAILY_LIMIT=50

# Pages per Gemini request (fewer requests vs. less risk of hitting output limits)
AUDIOBOOK_PAGES_PER_CHUNK=10

# Default voice for new readings (see the voice list in the app)
AUDIOBOOK_VOICE=af_heart

# Optional: keep the library somewhere else, e.g. a folder in iCloud Drive so it's backed up.
# Default: the library/ folder in this project.
# AUDIOBOOK_LIBRARY=/Users/you/Library/Mobile Documents/com~apple~CloudDocs/Audiobook library
